% compat.sty
% Venue-layout compatibility shim for the paper display API.
%
% It is available for venue-layout variants and release packaging. The factory
% paper/main.tex uses style/paper-harness.sty directly, so this shim is not loaded
% unless a venue-layout variant or official kit activates it. It provides the
% same macro names as paper-harness.sty (\parahead, \headbf, \figref/\tabref/
% \algref/\eqnref, \tablestyle, \cmark/\xmark, compact column types x/y/z/P/Y,
% and optional \papercolor/\paperstyle) on top of packages already loaded by the
% venue style. Canonical sections remain shared across internal and venue
% layouts.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{compat}[2026/08/28 v1.1 paper-harness venue-layout compat shim]

\makeatletter
\@ifpackageloaded{etoolbox}{}{\RequirePackage{etoolbox}}
\@ifpackageloaded{amsmath}{}{\RequirePackage{amsmath}}
\@ifpackageloaded{xcolor}{}{\RequirePackage{xcolor}}
\@ifpackageloaded{array}{}{\RequirePackage{array}}
\@ifpackageloaded{tabularx}{}{\RequirePackage{tabularx}}
\@ifpackageloaded{pifont}{}{\RequirePackage{pifont}}
\makeatother

% ---------------------------------------------------------------------
% Optional accent theme: \papercolor{<name>}, \paperstyle{accent|plain}
% ---------------------------------------------------------------------
\providecommand{\paperAccent}{}
\definecolor{paperAccentblue}{HTML}{1B4F8C}
\definecolor{paperAccentslate}{HTML}{2E2E2E}
\definecolor{paperAccentforest}{HTML}{1F5C3E}
\colorlet{paperAccent}{paperAccentblue}

\newbool{paperAccentEnabled}
\booltrue{paperAccentEnabled}

\providecommand{\papercolor}[1]{%
  \ifstrequal{#1}{blue}{\colorlet{paperAccent}{paperAccentblue}}{%
  \ifstrequal{#1}{slate}{\colorlet{paperAccent}{paperAccentslate}}{%
  \ifstrequal{#1}{forest}{\colorlet{paperAccent}{paperAccentforest}}{%
    \PackageError{compat}{Unknown paper color `#1'}{Available colors: blue, slate, forest.}%
  }}}%
}

\providecommand{\paperstyle}[1]{%
  \ifstrequal{#1}{accent}{\booltrue{paperAccentEnabled}}{%
  \ifstrequal{#1}{plain}{\boolfalse{paperAccentEnabled}}{%
    \PackageError{compat}{Unknown paper style `#1'}{Available styles: accent, plain.}%
  }}%
}

% ---------------------------------------------------------------------
% Display API: heading and cross-reference helpers
% ---------------------------------------------------------------------
\providecommand{\headbf}[1]{{\bfseries\ifbool{paperAccentEnabled}{\color{paperAccent}}{}#1}}
\providecommand{\parahead}[1]{\par\noindent\headbf{#1.}\enspace\ignorespaces}

\providecommand{\figref}[1]{Figure~\ref{#1}}
\providecommand{\tabref}[1]{Table~\ref{#1}}
\providecommand{\algref}[1]{Algorithm~\ref{#1}}
\providecommand{\eqnref}[1]{Equation~\eqref{#1}}

% ---------------------------------------------------------------------
% Display API: compact table helpers
% ---------------------------------------------------------------------
\providecommand{\tablestyle}[2]{\setlength{\tabcolsep}{#1}\renewcommand{\arraystretch}{#2}\centering\small}
\providecommand{\cmark}{\ding{51}}
\providecommand{\xmark}{\ding{55}}

\makeatletter
\@ifundefined{NC@find@x}{\newcolumntype{x}[1]{>{\centering\arraybackslash}p{#1pt}}}{}
\@ifundefined{NC@find@y}{\newcolumntype{y}[1]{>{\raggedright\arraybackslash}p{#1pt}}}{}
\@ifundefined{NC@find@z}{\newcolumntype{z}[1]{>{\raggedleft\arraybackslash}p{#1pt}}}{}
\@ifundefined{NC@find@P}{\newcolumntype{P}[1]{>{\centering\arraybackslash}p{#1}}}{}
\@ifundefined{NC@find@Y}{\newcolumntype{Y}{>{\centering\arraybackslash}X}}{}
\makeatother

\endinput
